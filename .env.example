# Banco
CARTOGRAFO_DB_PATH=cartografo.db

# HTTP / anti-bloqueio
CARTOGRAFO_DELAY=1.5
CARTOGRAFO_HTTP_TIMEOUT=30

# Modelo interno do banco (acoplado depois)
CARTOGRAFO_MODELO_ENDPOINT=
CARTOGRAFO_MODELO_TOKEN=
# Limite de caracteres do texto enviado ao LLM (0 desliga o corte)
CARTOGRAFO_MAX_CHARS_LLM=40000

# Agendamento (cron)
CARTOGRAFO_CRON_DOW=mon
CARTOGRAFO_CRON_HORA=7
